# Neon / Supabase Postgres 연결 문자열
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# 최소 32자 이상 권장
JWT_ACCESS_SECRET="change-this-to-a-very-long-access-secret"
JWT_REFRESH_SECRET="change-this-to-a-very-long-refresh-secret"

# 토큰 만료 시간
ACCESS_TOKEN_TTL_MINUTES="15"
REFRESH_TOKEN_TTL_DAYS="30"

# 선택값
COOKIE_DOMAIN=""
